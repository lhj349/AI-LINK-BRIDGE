{
  "manifestVersion": 5,
  "id": "com.codex.ai-link-bridge",
  "name": "AI Link Bridge",
  "version": "0.1.1",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "ai-link-bridge-panel",
      "label": {
        "default": "AI Link Bridge"
      },
      "minimumSize": {
        "width": 320,
        "height": 540
      },
      "maximumSize": {
        "width": 720,
        "height": 1200
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 680
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 760
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://127.0.0.1:3187",
        "http://localhost:3187"
      ]
    },
    "localFileSystem": "fullAccess"
  }
}
